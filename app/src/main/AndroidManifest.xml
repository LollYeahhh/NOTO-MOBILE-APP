<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Akses penggunaan: membaca aplikasi yang sedang di layar. Diberikan pengguna di Setelan Android, bukan lewat dialog. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Notifikasi (Android 13+): notifikasi pemantau dan pengingat kuota. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pemantau pemakaian berjalan sebagai foreground service (layanan latar dengan notifikasi tetap). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Menyalakan pemantau lagi setelah HP dinyalakan ulang. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Tampil di atas aplikasi lain: layar Terkunci boleh dibuka dari latar belakang (Tahap 7). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Supaya daftar aplikasi di Pilih Aplikasi terlihat (Android 11+): hanya aplikasi yang punya ikon di peluncur. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Supaya launcher bisa dikenali dan tidak dicatat pemantau. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NOTOAPP">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NOTOAPP"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layar Terkunci: task sendiri dan tidak tampil di Recent Apps, supaya tombol back tidak membawa
             kembali ke aplikasi yang dikunci atau ke layar Noto lain. -->
        <activity
            android:name=".service.TerkunciActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="id.noto.app.terkunci"
            android:theme="@style/Theme.NOTOAPP" />

        <!-- Layanan Aksesibilitas (opsional): hanya nama paket jendela yang berganti, untuk mengunci seketika.
             BIND_ACCESSIBILITY_SERVICE memastikan hanya sistem yang bisa menyambung ke layanan ini. -->
        <service
            android:name=".service.PengunciAksesibilitas"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aksesibilitas" />
        </service>

        <!-- Pemantau pemakaian. specialUse: tidak ada jenis foreground service bawaan untuk pelacak screen time. -->
        <service
            android:name=".service.PemantauService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks which app is on screen to enforce the user's own screen time limits." />
        </service>

        <receiver
            android:name=".service.MulaiSaatBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Alarm ringkasan harian/mingguan (Tahap 8D-3); hanya dipanggil AlarmManager milik Noto. -->
        <receiver
            android:name=".service.RingkasanAlarm"
            android:exported="false" />
    </application>

</manifest>